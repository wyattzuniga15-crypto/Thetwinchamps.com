# ── AI provider ──────────────────────────────────────────────────────────────
# Which provider to use: "anthropic" (default) or "openai" (any OpenAI-compatible API).
AI_PROVIDER=anthropic

# Anthropic (default provider)
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AI_MODEL=claude-sonnet-5           # main tutor model
# AI_FAST_MODEL=claude-haiku-4-5-20251001   # titles / lightweight tasks

# OpenAI-compatible provider (only used when AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite database + uploads live in .data/ by default. Override if desired:
# DATA_DIR=.data

# ── Limits ───────────────────────────────────────────────────────────────────
# Max upload size in megabytes (default 10)
# MAX_UPLOAD_MB=10
